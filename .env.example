# Copy to .env for local runs. Render holds the real values in an env group.
# Vercel needs ONLY the two NEXT_PUBLIC_ variables at the bottom.

# --- ERCOT -------------------------------------------------------------------
# Your apiexplorer.ercot.com portal login. The token flow authenticates as you.
ERCOT_USERNAME=
ERCOT_PASSWORD=

# The PRIMARY key from the Public API subscription.
#
# Never fail over to the secondary key at runtime. Both keys share one quota and
# one suspension status, so a runtime fallback does not buy availability — it
# just burns the spare. The secondary exists only so a key can be rotated
# without downtime: put it here, deploy, then regenerate the primary.
ERCOT_SUBSCRIPTION_KEY=

# --- Database ----------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → Transaction
# pooler (port 6543). Ingest connects as the Postgres role and bypasses RLS.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Service -----------------------------------------------------------------
# Guards POST /trigger/{job}, which can spend ERCOT rate-limit budget.
TRIGGER_SECRET=

# Settlement points to store. Comma-separated, or * for every point the report
# returns. Storing every node is roughly 105M five-minute rows a year — well
# past what the Postgres tier is sized for. Defaults to hubs and load zones.
# TRACKED_POINTS=HB_HUBAVG,HB_NORTH,LZ_HOUSTON

# Optional per-job heartbeat URLs (healthchecks.io or similar). Without these a
# job that silently stops returning rows will not tell anyone.
# HEARTBEAT_URL_LMP5=
# HEARTBEAT_URL_RTM=
# HEARTBEAT_URL_DAM=

# Set false to run the API without starting the scheduler (useful locally).
# SCHEDULER_ENABLED=true

# --- Raw auction archive (optional but time-sensitive) -----------------------
# ERCOT's MIS listing holds only the last 12 monthly CRR auctions, so one is
# deleted at source every month and cannot be recovered afterwards. With these
# set, each auction's raw zip is copied to a private Supabase Storage bucket
# ('crr-raw') before parsing, which is what makes re-parsing possible if a
# column turns out to matter later.
#
# The SERVICE key, not the publishable one: this writes to a private bucket.
# It must never reach the dashboard or any browser.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=

# --- Dashboard (Vercel) ------------------------------------------------------
# The dashboard reads Supabase directly through RLS with the anon key. It does
# NOT need the ERCOT credentials, and it must never be given the service-role
# key or DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
